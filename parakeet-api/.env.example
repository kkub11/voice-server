# Copy to .env and fill in:  cp .env.example .env
# Generate a key with:       openssl rand -hex 24
# Clients must send it as:   Authorization: Bearer <key>
SERVER__API_KEY=change-me

# Model selection (sherpa-onnx). Default download is the Parakeet TDT 0.6B
# v3 int8 model (25 European languages, ~6.32% avg WER on the HF Open ASR
# Leaderboard). For English-only dictation, v2 is slightly more accurate
# (~6.05% WER). To try it, set STT__SHERPA__MODEL_ID to the v2 model's
# sherpa-onnx name — confirm the exact name on the sherpa-onnx asr-models
# releases page first; don't guess it.
